{
  "uid": "trialscribe-dependencies",
  "title": "TrialScribe dependencies",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Redis up",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AI provider failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_provider_calls_total{outcome=~\"timeout|error|circuit_open\"}[5m])) by (provider, operation)"
        }
      ]
    }
  ]
}
