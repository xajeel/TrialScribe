{
  "uid": "trialscribe-events",
  "title": "TrialScribe Kafka events",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Dead-lettered events",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_events_consumed_total{result=\"dead_letter\"}[5m])) by (event_type)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consume results",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_events_consumed_total[5m])) by (event_type, result)"
        }
      ]
    }
  ]
}
