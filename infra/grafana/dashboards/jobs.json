{
  "uid": "trialscribe-jobs",
  "title": "TrialScribe jobs",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Failed jobs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_jobs_total{outcome=\"failed\"}[5m])) by (kind)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Job outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_jobs_total[5m])) by (kind, outcome)"
        }
      ]
    }
  ]
}
