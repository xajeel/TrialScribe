{
  "uid": "trialscribe-http",
  "title": "TrialScribe HTTP",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API errors (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_http_requests_total{status=~\"5..\"}[5m])) by (service)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trialscribe_http_requests_total[5m])) by (service, handler)"
        }
      ]
    }
  ]
}
